# Required. API_KEY is also accepted (docker run -e API_KEY=...).
OPENAI_API_KEY=sk-...
# Model used by ask.py for the sanity check (the Playground assistant should use the same one).
OPENAI_MODEL=gpt-5.6-luna
# Optional: reuse a specific vector store. If empty, one named VECTOR_STORE_NAME is found or created.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb
# Optional: 0 = all articles in the help center.
MAX_ARTICLES=0
ZENDESK_BASE_URL=https://support.optisigns.com
